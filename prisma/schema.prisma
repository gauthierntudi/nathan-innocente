generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id                 String           @id @default(cuid())
  phone              String           @unique
  name               String
  genre              String           @default("Cher(e)")
  token              String           @unique
  deviceId           String?          @map("device_id")
  status             String           @default("pending")
  statusSend         Boolean          @default(false) @map("status_send")
  statusReminderSent Boolean          @default(false) @map("status_reminder_sent")
  availability       Boolean?
  confirmedGuests    Int              @default(0) @map("confirmed_guests")
  numGuests          Int              @default(1) @map("num_guests")
  phoneFictitious    Boolean          @default(false) @map("phone_fictitious")
  guestType          String           @default("standard") @map("guest_type")
  /** Parcours invitation (enveloppes) au lieu du dress code */
  invitationEnabled  Boolean          @default(false) @map("invitation_enabled")
  dressCodeDownloadedAt DateTime?     @map("dress_code_downloaded_at")
  /** SID Twilio du dernier message d'invitation */
  inviteMessageSid   String?          @map("invite_message_sid")
  /** queued | accepted | sending | sent | delivered | read | undelivered | failed */
  inviteDeliveryStatus String?        @map("invite_delivery_status")
  inviteDeliveryError String?         @map("invite_delivery_error")
  inviteStatusAt     DateTime?        @map("invite_status_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  guestCeremonies    GuestCeremony[]
  duplicates         GuestDuplicate[]
  fictitiousRecord   GuestFictitious?

  @@index([availability])
  @@index([statusSend])
  @@index([dressCodeDownloadedAt])
  @@index([phoneFictitious])
  @@index([guestType])
  @@index([invitationEnabled])
  @@map("guests")
}

/// Invités créés sans vrai numéro — téléphone aléatoire généré.
model GuestFictitious {
  id        String   @id @default(cuid())
  guestId   String   @unique @map("guest_id")
  phone     String
  name      String
  genre     String   @default("Cher(e)")
  numGuests Int      @default(1) @map("num_guests")
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@map("guest_fictitious")
}

/// Invitation avec le même téléphone qu’un invité, mais un nom totalement différent.
model GuestDuplicate {
  id          String   @id @default(cuid())
  phone       String
  name        String
  genre       String   @default("Cher(e)")
  numGuests   Int      @default(1) @map("num_guests")
  ceremonyIds String[] @default([]) @map("ceremony_ids")
  guestId     String   @map("guest_id")
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@index([guestId])
  @@map("guest_duplicates")
}

model Ceremony {
  id          String          @id
  name        String
  sortOrder   Int             @default(0) @map("sort_order")
  tables      CeremonyTable[]
  groups      CeremonyGroup[]
  assignments GuestCeremony[]

  @@map("ceremonies")
}

model CeremonyTable {
  id          String          @id @default(cuid())
  ceremonyId  String          @map("ceremony_id")
  name        String
  capacity    Int?
  sortOrder   Int             @default(0) @map("sort_order")
  ceremony    Ceremony        @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)
  assignments GuestCeremony[]

  @@index([ceremonyId])
  @@map("ceremony_tables")
}

model CeremonyGroup {
  id          String          @id @default(cuid())
  ceremonyId  String          @map("ceremony_id")
  name        String
  sortOrder   Int             @default(0) @map("sort_order")
  ceremony    Ceremony        @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)
  assignments GuestCeremony[]

  @@index([ceremonyId])
  @@map("ceremony_groups")
}

model GuestCeremony {
  id                    String         @id @default(cuid())
  guestId               String         @map("guest_id")
  ceremonyId            String         @map("ceremony_id")
  tableId               String?        @map("table_id")
  groupId               String?        @map("group_id")
  numGuests             Int            @default(1) @map("num_guests")
  availability          Boolean?
  confirmedGuests       Int            @default(0) @map("confirmed_guests")
  respondedAt           DateTime?      @map("responded_at")
  dressCodeDownloadedAt DateTime?      @map("dress_code_downloaded_at")
  guest                 Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  ceremony              Ceremony       @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)
  table                 CeremonyTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  group                 CeremonyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([guestId, ceremonyId])
  @@index([ceremonyId])
  @@index([tableId])
  @@index([groupId])
  @@index([availability])
  @@index([dressCodeDownloadedAt])
  @@map("guest_ceremonies")
}
