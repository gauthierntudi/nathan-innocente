# =============================================================================
# Variables d'environnement — mariage-next
# Copier vers .env en local, puis configurer dans Vercel → Settings → Environment Variables
# =============================================================================

# --- Base de données (Neon) ---
# Utiliser l'URL *pooler* pour Vercel (serverless) : ep-xxx-pooler.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Application ---
# URL publique du site (domaine custom ou *.vercel.app)
APP_URL="https://nathan-innocente.com"
ADMIN_PASSWORD="change-me"
# true = affiche « Invitation à venir » aux invités confirmés dress code sans table
INVITATION_WAITING_ENABLED=false

# --- Dress code (Cloudflare R2 public) ---
NEXT_PUBLIC_DRESS_CODE_BASE_URL="https://pub-5ff2b676c3a745bb957c2e00cc6690d6.r2.dev/dresscode"
NEXT_PUBLIC_DRESS_CODE_FILE_COUTUMIER="I&N-Dress-code-Coutumier.pdf"
NEXT_PUBLIC_DRESS_CODE_FILE_CIVILE="I&N-Dress-code-Civile.pdf"
NEXT_PUBLIC_DRESS_CODE_FILE_RELIGIEUX="I&N-Dress-code-Religieux.pdf"
NEXT_PUBLIC_DRESS_CODE_FILE_RECEPTION="I&N-Dress-code-Reception.pdf"
# Invités d'honneur (groupe honor) — civil & religieux uniquement
NEXT_PUBLIC_DRESS_CODE_FILE_CIVILE_HONOR="invite-honneur-dress-code-civil.pdf"
NEXT_PUBLIC_DRESS_CODE_FILE_RELIGIEUX_HONOR="invite-honneur-dress-code-religieux.pdf"
# NEXT_PUBLIC_DRESS_CODE_FILE_DEFAULT="I&N-Dress-code-Coutumier.pdf"

# --- Invitations PDF (Cloudflare R2 public, dossier mariage/invitations) ---
NEXT_PUBLIC_INVITATION_BASE_URL="https://pub-5ff2b676c3a745bb957c2e00cc6690d6.r2.dev/invitations"
NEXT_PUBLIC_INVITATION_FILE_COUTUMIER="invitation-coutumier.pdf"
NEXT_PUBLIC_INVITATION_FILE_CIVILE="invitation-civil.pdf"
NEXT_PUBLIC_INVITATION_FILE_RELIGIEUX="invitation-religieux.pdf"

# --- Demande en mariage (Cloudflare R2 public) ---
NEXT_PUBLIC_DEMANDE_MARIAGE_BASE_URL="https://pub-5ff2b676c3a745bb957c2e00cc6690d6.r2.dev/demande-mariage"
# NEXT_PUBLIC_DEMANDE_MARIAGE_FILES="0T8A5173.jpg,0T8A5174.jpg,0T8A5178.jpg,0T8A5185.jpg,0T8A5203.jpg,0T8A5252.jpg"

# --- Vidéos (Cloudflare R2 public, dossier mariage/videos) ---
NEXT_PUBLIC_VIDEOS_BASE_URL="https://pub-5ff2b676c3a745bb957c2e00cc6690d6.r2.dev/videos"
NEXT_PUBLIC_ETERNITE_VIDEO_FILE="reelss.mp4"
# NEXT_PUBLIC_ETERNITE_VIDEO_URL="https://pub-5ff2b676c3a745bb957c2e00cc6690d6.r2.dev/videos/reelss.mp4"

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+243815439024"
TWILIO_TEMPLATE_INVITE="HX22c1ab6f9322915eee97777590edc660"
# Invitation : {{1}} genre, {{2}} nom — envoi si invité affecté à une table
TWILIO_TEMPLATE_REMINDER="HX11fd9cc8f9de40917f722e4424d3b942"
TWILIO_TEMPLATE_CONFIRM="HXed0831cb5bb7b160d4bf8d32bfb99c34"
# Confirmation : {{1}} = nom du fichier dress code (média Document)
TWILIO_TEMPLATE_DECLINE="HXcc83ceeb13c342b070685a6215073f0a"
# Templates cérémonie — un Content SID par cérémonie ({{1}} genre, {{2}} nom)
TWILIO_TEMPLATE_CEREMONY_COUTUMIER=""
TWILIO_TEMPLATE_CEREMONY_CIVILE=""
TWILIO_TEMPLATE_CEREMONY_RELIGIEUX=""
# Invitation d'honneur (invité affecté à plus d'une cérémonie)
TWILIO_TEMPLATE_INVITE_HONOR="HXeb0b648d9e5a920d5cbc188c0367b6cd"

# --- VdoCipher (optionnel — vidéo retirée du parcours invité) ---
VDOCIPHER_VIDEO_ID=""
VDOCIPHER_API_SECRET=""

# --- Seed local uniquement (pas nécessaire sur Vercel) ---
GUESTS_JSON_PATH="../backup/guests.json"
SEED_RESET=false
PRISMA_HIDE_UPDATE_MESSAGE=1
